/* 
  # Empêche le clickjacking
  X-Frame-Options: DENY

  # Bloque le MIME sniffing
  X-Content-Type-Options: nosniff

  # Politique de confidentialité des referers
  Referrer-Policy: strict-origin-when-cross-origin

  # Protection XSS moderne via CSP
  Content-Security-Policy: 
    default-src 'self';
    script-src 'self';                       # Supprime 'unsafe-inline' pour éviter le XSS
    style-src 'self' 'unsafe-inline';       # React inline styles autorisés
    img-src 'self' data: https://flagcdn.com; 
    font-src 'self';                        # Pas besoin de data: si fonts locales
    connect-src 'self';
    frame-ancestors 'none';
    upgrade-insecure-requests;
    report-uri /csp-report;                 # Pour recevoir les violations CSP

  # HSTS : force HTTPS (optionnel selon ton hébergeur)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
